<Window x:Class="HelpDeskCustomer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel Zgłoszeń" Height="2284" Width="1403"
        Icon="pack://application:,,,/images/logocustomer.ico">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lista folderów z zgłoszeniami -->
        <ListBox x:Name="listBoxFolders" Grid.Column="0" SelectionChanged="listBoxFolders_SelectionChanged" />

        <!-- Szczegóły zgłoszenia -->
        <StackPanel Grid.Column="1" Margin="10,0">
            <TextBlock Text="Tytuł:" FontWeight="Bold" />
            <TextBlock x:Name="txtTitle" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock Text="Treść:" FontWeight="Bold" />
            <TextBlock x:Name="txtDescription" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock Text="Priorytet:" FontWeight="Bold" />
            <TextBlock x:Name="txtPriority" Margin="0,0,0,10"/>

            <TextBlock Text="Data zgłoszenia:" FontWeight="Bold" />
            <TextBlock x:Name="txtTimestamp" Margin="0,0,0,10"/>

            <TextBlock Text="Nazwa użytkownika:" FontWeight="Bold" />
            <TextBlock x:Name="txtUserName" Margin="0,0,0,10"/>

            <TextBlock Text="Status:" FontWeight="Bold" />
            <TextBlock x:Name="txtStatus" Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Załączniki i podgląd obrazka oraz przyciski -->
        <Grid Grid.Column="2" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox x:Name="listBoxAttachments" Grid.Row="0" SelectionChanged="listBoxAttachments_SelectionChanged" />

            <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="0,5,0,5">
                <Image x:Name="imageViewer" Stretch="Uniform" />
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                <Button x:Name="btnOpenFolder" Content="Otwórz folder" Width="110" Margin="0,0,10,0" Click="btnOpenFolder_Click"/>
                <Button x:Name="btnGenerateESP" Content="Generuj ESP" Width="110" Margin="0,0,10,0" Click="btnGenerateESP_Click"/>
                <Button x:Name="btnRefresh" Content="Odśwież" Width="110" Margin="0,0,10,0" Click="btnRefresh_Click"/>
            </StackPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Height="200" Margin="0,10,0,0">
                <StackPanel x:Name="espResultPanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
