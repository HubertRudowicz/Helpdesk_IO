<Window x:Class="HelpDeskAdmin.DateRangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wybierz przedział dat" Height="200" Width="300" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="Data początkowa:" Margin="0,0,0,5"/>
        <DatePicker x:Name="dpStart" Margin="0,0,0,10"/>

        <TextBlock Text="Data końcowa:" Margin="0,0,0,5"/>
        <DatePicker x:Name="dpEnd" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="75" Margin="0,0,5,0" Click="Ok_Click"/>
            <Button Content="Anuluj" Width="75" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
