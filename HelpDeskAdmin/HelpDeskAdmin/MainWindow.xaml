<Window x:Class="HelpDeskAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpDesk Admin Panel" Height="800" Width="1400"
        Icon="pack://application:,,,/images/logoadmin.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Gradients -->
        <LinearGradientBrush x:Key="MainBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1a1a2e" Offset="0"/>
            <GradientStop Color="#16213e" Offset="0.5"/>
            <GradientStop Color="#0f3460" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1e1e3f" Offset="0"/>
            <GradientStop Color="#2a2a5a" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2a2a5a" Offset="0"/>
            <GradientStop Color="#1e1e3f" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryButtonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <!-- Delikatny niebieski gradient dla sekcji tytułu -->
        <LinearGradientBrush x:Key="TitleCardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4A90E2" Offset="0"/>
            <GradientStop Color="#357ABD" Offset="1"/>
        </LinearGradientBrush>

        <!-- Styles -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardGradient}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000" BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#667eea" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#3a3a6a"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8" 
                                            Margin="5" 
                                            Padding="15,12"
                                            x:Name="ItemBorder">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                                        </Border.Effect>
                                        <TextBlock Text="{TemplateBinding Content}" 
                                                   Foreground="White"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   FontSize="14" 
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#4A90E2"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#4a4a7a"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="SubHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#b0b0b0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ContentText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1e1e3f"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#667eea"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#667eea" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource MainBackgroundGradient}" CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1a1a2e" CornerRadius="15,15,0,0" 
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <Button Width="12" Height="12" Background="#ff5f57" Margin="0,0,8,0" 
                                Click="CloseButton_Click" BorderThickness="0" ToolTip="Zamknij"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse Fill="{TemplateBinding Background}" 
                                             Width="{TemplateBinding Width}" 
                                             Height="{TemplateBinding Height}"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="12" Height="12" Background="#ffbd2e" Margin="0,0,8,0" 
                                Click="MinimizeButton_Click" BorderThickness="0" ToolTip="Minimalizuj"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse Fill="{TemplateBinding Background}" 
                                             Width="{TemplateBinding Width}" 
                                             Height="{TemplateBinding Height}"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="12" Height="12" Background="#28ca42" Margin="0,0,20,0" 
                                Click="MaximizeButton_Click" BorderThickness="0" ToolTip="Pełny ekran / Okno"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse Fill="{TemplateBinding Background}" 
                                             Width="{TemplateBinding Width}" 
                                             Height="{TemplateBinding Height}"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="HeaderTitle" Text="Panel Informatyka" 
                                   Style="{StaticResource HeaderText}" 
                                   FontSize="20" 
                                   Margin="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <Button Content="Ustaw Status" Style="{StaticResource ModernButton}" Click="UstawStatus_Click" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Reports List -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Aktywne Zgłoszenia" Style="{StaticResource HeaderText}" FontSize="18"/>

                        <ListBox x:Name="listBoxFolders" 
                                 Grid.Row="1" 
                                 Style="{StaticResource ModernListBox}"
                                 SelectionChanged="listBoxFolders_SelectionChanged"/>
                    </Grid>
                </Border>

                <!-- Details Panel -->
                <Border Grid.Column="1" Style="{StaticResource ModernCard}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Szczegóły Zgłoszenia" Style="{StaticResource HeaderText}" FontSize="18"/>

                            <!-- Info Cards -->
                            <Border Background="{StaticResource TitleCardGradient}" 
                                    CornerRadius="10" 
                                    Padding="15" 
                                    Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Tytuł:" Style="{StaticResource SubHeaderText}" FontSize="12" Foreground="White"/>
                                    <TextBlock x:Name="txtTitle" Style="{StaticResource ContentText}" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#2a2a5a" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Opis:" Style="{StaticResource SubHeaderText}"/>
                                    <TextBlock x:Name="txtDescription" Style="{StaticResource ContentText}"/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#2a2a5a" CornerRadius="10" Padding="15" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="Priorytet:" Style="{StaticResource SubHeaderText}"/>
                                        <TextBlock x:Name="txtPriority" Style="{StaticResource ContentText}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#2a2a5a" CornerRadius="10" Padding="15" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Status:" Style="{StaticResource SubHeaderText}"/>
                                        <TextBlock x:Name="txtStatus" Style="{StaticResource ContentText}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#2a2a5a" CornerRadius="10" Padding="15" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="Użytkownik:" Style="{StaticResource SubHeaderText}"/>
                                        <TextBlock x:Name="txtUserName" Style="{StaticResource ContentText}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#2a2a5a" CornerRadius="10" Padding="15" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Data:" Style="{StaticResource SubHeaderText}"/>
                                        <TextBlock x:Name="txtTimestamp" Style="{StaticResource ContentText}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Notes Section -->
                            <Border Background="#2a2a5a" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Notatki:" Style="{StaticResource SubHeaderText}"/>
                                    <TextBox x:Name="txtNotes" 
                                             Style="{StaticResource ModernTextBox}"
                                             Height="80" 
                                             TextWrapping="Wrap" 
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,10"/>
                                    <Button x:Name="btnSaveNotes" 
                                            Content="💾 Zapisz notatki" 
                                            Style="{StaticResource ModernButton}"
                                            HorizontalAlignment="Left"
                                            Click="btnSaveNotes_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Attachments and Actions -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Attachments -->
                        <TextBlock Grid.Row="0" Text="Załączniki" Style="{StaticResource HeaderText}" FontSize="18"/>

                        <ListBox x:Name="listBoxAttachments" 
                                 Grid.Row="1" 
                                 Style="{StaticResource ModernListBox}"
                                 SelectionChanged="listBoxAttachments_SelectionChanged"
                                 MouseDoubleClick="listBoxAttachments_MouseDoubleClick"/>

                        <!-- Image Viewer -->
                        <Border Grid.Row="2" 
                                Background="#1e1e3f" 
                                CornerRadius="10" 
                                Margin="0,15,0,15"
                                BorderBrush="#444" 
                                BorderThickness="2">
                            <Image x:Name="imageViewer" 
                                   Stretch="Uniform" 
                                   Margin="10"/>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="btnOpenFolder" Content="📁" Width="50" Height="50" 
                                    Style="{StaticResource ModernButton}" 
                                    ToolTip="Otwórz folder"
                                    Click="btnOpenFolder_Click"/>
                            <Button x:Name="btnGenerateESP" Content="📊" Width="50" Height="50" 
                                    Style="{StaticResource ModernButton}"
                                    ToolTip="Generuj ESP"
                                    Click="btnGenerateESP_Click"/>
                            <Button x:Name="btnRefresh" Content="🔄" Width="50" Height="50" 
                                    Style="{StaticResource ModernButton}"
                                    ToolTip="Odśwież"
                                    Click="btnRefresh_Click"/>
                            <Button x:Name="btnMarkDone" Content="✅" Width="50" Height="50" 
                                    Background="#28ca42"
                                    Style="{StaticResource ModernButton}"
                                    ToolTip="Zakończone"
                                    Click="btnMarkDone_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>